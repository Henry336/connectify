generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  createdBy        String
  hostTokenHash    String?
  currentTrackId   String?
  isPlaying        Boolean  @default(false)
  playbackPosition Float    @default(0)
  startedAt        DateTime?
  autopilotEnabled Boolean  @default(true)
  autoplayMinBuffer Int     @default(4)
  partyMode        String   @default("standard")
  theme            String   @default("violet")
  isLocked         Boolean  @default(false)
  guestsCanControl Boolean  @default(true)
  guestsCanAdd     Boolean  @default(true)
  maxSongsPerUser  Int      @default(5)
  maxParticipants  Int      @default(50)
  chatSlowMode     Int      @default(0)
  discoverable     Boolean  @default(true)
  revision         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tracks           Track[]
  moments          Moment[]
  members          RoomMember[]
  messages         ChatMessage[]
  operations       RoomOperation[]
  activities       RoomActivity[]
}

model Track {
  id         String   @id @default(cuid())
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  url        String
  provider   String
  providerId String
  title      String
  artist     String
  thumbnail  String?
  duration   Float?
  addedBy    String
  addedByUserId String?
  position   Int
  votes      Int      @default(0)
  playedAt   DateTime?
  removedAt  DateTime?
  removedBy  String?
  playNext   Boolean  @default(false)
  autoplayBlocked Boolean @default(false)
  createdAt  DateTime @default(now())
  trackVotes TrackVote[]
  moments    Moment[]
  messages   ChatMessage[]

  @@index([roomId, position])
}

model TrackVote {
  id        String   @id @default(cuid())
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([trackId, userId])
  @@index([userId])
}

model Moment {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  avatar    String
  emoji     String
  position  Float
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
  @@index([trackId, position])
}

model RoomMember {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  avatar      String
  role        String   @default("guest")
  isBanned    Boolean  @default(false)
  joinedAt    DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([roomId, userId])
  @@index([roomId, lastSeenAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  trackId   String?
  track     Track?   @relation(fields: [trackId], references: [id], onDelete: SetNull)
  userId    String
  name      String
  avatar    String
  body      String
  position  Float?
  spoiler   Boolean  @default(false)
  replyToId String?
  replyTo   ChatMessage?  @relation("ChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("ChatReplies")
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
  @@index([trackId, position])
  @@index([replyToId])
}

model RoomOperation {
  id          String    @id
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId      String
  action      String
  result      Json?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([roomId, createdAt])
  @@index([createdAt])
}

model RoomActivity {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actorId   String
  actorName String
  action    String
  target    String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

model SearchCache {
  key       String   @id
  query     String
  pageToken String?
  response  Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}
