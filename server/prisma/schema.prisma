generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  createdBy        String
  currentTrackId   String?
  isPlaying        Boolean  @default(false)
  playbackPosition Float    @default(0)
  startedAt        DateTime?
  revision         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tracks           Track[]
}

model Track {
  id         String   @id @default(cuid())
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  url        String
  provider   String
  providerId String
  title      String
  artist     String
  thumbnail  String?
  duration   Float?
  addedBy    String
  position   Int
  votes      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([roomId, position])
}
