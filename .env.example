# Server
# Use Neon's pooled hostname (it contains "-pooler") for lower connection overhead.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/connectify?sslmode=require"
CLIENT_URL="http://localhost:5173"
PORT=3001
# Optional: enables live YouTube catalog search. URL paste and Connectify Library still work without it.
YOUTUBE_API_KEY=""
# Optional: a second Google Cloud API key dedicated to the automated Library-growth job, so it
# never competes with real users' live-search quota. Falls back to YOUTUBE_API_KEY if unset
# (sharing its daily quota instead). Create it the same way as YOUTUBE_API_KEY, in a project
# with YouTube Data API v3 enabled.
YOUTUBE_SEED_API_KEY=""
# Optional: how many search.list calls (100 quota units each, ~25 candidate songs per call)
# the Library-growth job spends per run, roughly once every 20 hours. Default 30.
LIBRARY_SEED_DAILY_BUDGET="30"
# Optional: protects GET /api/metrics/dashboard. Generate a long random value in production.
METRICS_ADMIN_TOKEN=""
# Optional: set to "all" briefly to log every database query duration. Slow production queries are logged automatically.
DB_TIMINGS=""

# Client (copy to client/.env.local)
VITE_API_URL="http://localhost:3001"
VITE_SITE_URL="http://localhost:5173"
# Optional after registering the production Vercel URL in Google Search Console.
VITE_GOOGLE_SITE_VERIFICATION=""
