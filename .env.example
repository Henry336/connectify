# Server
# Use Neon's pooled hostname (it contains "-pooler") for lower connection overhead.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/connectify?sslmode=require"
CLIENT_URL="http://localhost:5173"
PORT=3001
# Optional: enables live YouTube catalog search. URL paste and Connectify Library still work without it.
YOUTUBE_API_KEY=""

# Client (copy to client/.env.local)
VITE_API_URL="http://localhost:3001"
VITE_SITE_URL="http://localhost:5173"
# Optional after registering the production Vercel URL in Google Search Console.
VITE_GOOGLE_SITE_VERIFICATION=""
